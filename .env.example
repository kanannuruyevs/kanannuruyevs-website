# ===================================================
# KANAN NURUYEV PORTFOLIO - SOCIAL MEDIA API KEYS
# ===================================================
# Copy this file to '.env' locally or add these keys to 
# your Vercel / Netlify Environment Variables dashboard.
# DO NOT commit your real '.env' file to GitHub!

# Google / YouTube Data API v3 Key
# Get key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Instagram Graph API Access Token (Optional)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# TikTok Open API Access Token (Optional)
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
